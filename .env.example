# Ficheiro local privado. Copie para .env e use --env-file .env ao iniciar.
KIKO_ENV=development
KIKO_ALLOW_EXAMPLE_PROMPTS=true
KAGGLE_API_TOKEN=
KIKO_MODEL=
KIKO_ALLOWED_UIDS=
FIREBASE_PROJECT_ID=
# Escolha ficheiro OU JSON; não publique nenhum deles.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Deixe vazio para procurar /etc/secrets e depois backend/prompts-private no desenvolvimento.
KIKO_PROMPTS_DIR=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
STREAM_MODE=auto
KAGGLE_CHAT_PATH=/openapi/v1/chat/completions
# Opcional: aliases personalizados, sempre validados contra LLMS_AVAILABLE.
MODEL_ALIASES_JSON=
MAX_FILE_MB=10
MAX_TOTAL_MB=50
MAX_FILES=20
FILE_TTL_HOURS=6
MAX_DOC_CHARS=35000
MAX_CONTEXT_CHARS=120000
MAX_ATTACHMENTS=4
RATE_LIMIT_PER_MINUTE=20
